{
 "hosting": {
  "public": "site",
  "ignore": [
   "**/.*"
  ],
  "headers": [
   {
    "source": "/",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "/index.html",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "/lessons/**",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public, max-age=604800"
     }
    ]
   }
  ]
 }
}
